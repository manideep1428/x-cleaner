{
  "manifest_version": 3,
  "name": "X Link Cleaner",
  "version": "1.0.0",
  "description": "Removes the tracking query (like ?s=46&t=…) from X / Twitter post links when you open or copy them.",
  "minimum_chrome_version": "111",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.x.com/*", "https://*.twitter.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_post_query",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://*.x.com/*", "https://*.twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
